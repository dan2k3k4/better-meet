{
  "manifest_version": 3,
  "name": "Better Meet",
  "short_name": "Better Meet",
  "description": "Better Meet for Google Meet: join muted, get notified when someone is waiting, and see how long you've been in the call.",
  "version": "0.1.1",
  "icons": { "128": "icon.png" },
  "permissions": ["storage", "notifications"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false }
}
